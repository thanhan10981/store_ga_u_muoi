# LOCAL only. Copy to .env.chatmock-tunnel after configuring Cloudflare.
# Published application route: chatmock.vothanhan.dev -> http://127.0.0.1:8001
CHATMOCK_PUBLIC_URL=https://chatmock.vothanhan.dev
# Copy only the tunnel token from the Cloudflare connector command.
# Do not paste the whole command. Never commit or share this token.
CLOUDFLARE_TUNNEL_TOKEN=
