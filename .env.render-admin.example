# Local bootstrap only. Never put these admin credentials on Vercel or in API env.
# Neon direct connection (disable connection pooling in the Neon connection dialog).
# neondb_owner is for this bootstrap only; runtime must use store_app.
DATABASE_URL=postgresql://neondb_owner:URL_ENCODED_ADMIN_PASSWORD@YOUR_DIRECT_HOST.neon.tech/neondb?sslmode=verify-full
STORE_APP_PASSWORD=
OWNER_USERNAME=owner
OWNER_PASSWORD=
