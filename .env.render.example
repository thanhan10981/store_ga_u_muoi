# Render backend environment only; no NEXT_PUBLIC_ variables.
NODE_ENV=production
BACKEND_HOST=0.0.0.0
# Use the frontend domain you actually open. No trailing slash.
APP_ORIGIN=https://vothanhan.dev
# Neon DIRECT connection with the restricted store_app role, not neondb_owner.
# URL-encode the password. Keep TLS certificate/hostname verification enabled.
DATABASE_URL=postgresql://store_app:URL_ENCODED_APP_PASSWORD@YOUR_DIRECT_HOST.neon.tech/neondb?sslmode=verify-full
BACKEND_PROXY_SECRET=
OWNER_TOTP_SECRET=
AI_PROVIDER=openai
# Required only for AI_PROVIDER=openai.
OPENAI_API_KEY=
STORE_AI_MODEL=
AI_DAILY_LIMIT=100
# For AI_PROVIDER=chatmock, instead of an OpenAI key:
# CHATMOCK_BASE_URL=https://chatmock.your-domain.dev/v1
# CHATMOCK_GATEWAY_SECRET=<same as the PC gateway>
