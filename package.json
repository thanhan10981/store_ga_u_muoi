{
  "name": "mach-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backend:dev": "node --env-file-if-exists=.env.backend backend/server.mjs",
    "backend:migrate": "node --env-file-if-exists=.env.backend backend/admin.mjs migrate",
    "backend:owner": "node --env-file-if-exists=.env.backend backend/admin.mjs owner",
    "test:backend": "node --test backend/tests/*.test.mjs",
    "render:setup": "node --env-file=.env.render-admin deploy/render-setup.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "openai": "7.34.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
