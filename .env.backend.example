# Local backend; copy to .env.backend. Frontend .env.local also needs:
# STORE_BACKEND_URL=http://127.0.0.1:4000
# BACKEND_PROXY_SECRET=<same secret as below>
# APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://store_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/store
BACKEND_PROXY_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:3000
OPENAI_API_KEY=
STORE_AI_MODEL=
AI_DAILY_LIMIT=100
# Optional for local; required in production.
OWNER_TOTP_SECRET=
