# Copy this file to .env.local. Enter your key ONLY in that local file.
# Never prefix the API key with NEXT_PUBLIC_. Never commit .env.local.
# openai = direct API; chatmock = local ChatGPT-authenticated gateway.
AI_PROVIDER=chatmock
OPENAI_API_KEY=your_openai_api_key_here
# Must support text generation + streaming through the Responses API.
OPENAI_MODEL=gpt-5.6-terra
# For local ChatMock: set AI_PROVIDER=chatmock. No OpenAI API key is sent to it.
CHATMOCK_BASE_URL=http://127.0.0.1:8000/v1
